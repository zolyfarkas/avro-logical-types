<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.spf4j</groupId>
  <artifactId>avro-logical-types-gen</artifactId>
  <version>1.4p-SNAPSHOT</version>
  <packaging>jar</packaging>
  <parent>
    <groupId>org.spf4j</groupId>
    <artifactId>spf4j</artifactId>
    <version>8.9.9</version>
  </parent>
  <name>${project.artifactId}-${project.version}</name>
  <description>A bunch of additional avro logical types</description>

  <properties>
    <!-- The standalone org.spf4j.avro library is Java 11 bytecode, so this
         module can no longer build with the parent pom's JDK 8 defaults
         (java.version 1.8, java8.home pointing at a macOS JDK 8 install).
         Build with a JDK 11+ JAVA_HOME; the parent's compiler and surefire
         forks both take their executable from java8.home. -->
    <java.version>11</java.version>
    <java8.home>${env.JAVA_HOME}</java8.home>
  </properties>

  <scm>
    <connection>scm:git:https://github.com/zolyfarkas/avro-logical-types.git</connection>
    <developerConnection>scm:git:https://github.com/zolyfarkas/avro-logical-types.git</developerConnection>
    <url>https://github.com/zolyfarkas/avro-logical-types/</url>
    <tag>HEAD</tag>
  </scm>


<build>
  <plugins>
      <plugin>
        <groupId>eu.somatik.serviceloader-maven-plugin</groupId>
        <artifactId>serviceloader-maven-plugin</artifactId>
        <version>1.4.0</version>
        <configuration>
          <services>
            <param>org.spf4j.avro.Conversion</param>
            <param>org.spf4j.avro.LogicalTypes$LogicalTypeFactory</param>
          </services>
        </configuration>
        <executions>
          <execution>
            <phase>process-classes</phase>
            <goals>
              <goal>generate</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- The spf4j surefire run listeners (Spf4jRunListener /
           DetailOnFailureRunListener) are bound to the fork avro
           (org.apache.avro.specific.SpecificRecordBase), which this module
           no longer depends on; the listener configuration is dropped so
           the suite runs on plain surefire against the standalone
           library. -->
      <!--
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
            <excludeFilterFile>findbugs_exclude.xml</excludeFilterFile>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
           <configLocation>checkstyle_checks.xml</configLocation>
        </configuration>
      </plugin>
            -->
  </plugins>
</build>

  <dependencies>
    <!-- The previous test-scope spf4j artifacts (spf4j-junit,
         spf4j-slf4j-test) are bound to the fork avro: their surefire
         listeners and their slf4j test binder reference
         org.apache.avro.specific.SpecificRecordBase, and their transitive
         avro artifacts (spf4j-avro-adapter's lib-ext
         org.spf4j.avro.SchemaResolver, the previous published
         avro-logical-types-fork) collide by class name with this module
         and with the standalone library. Test scope now uses plain junit
         plus a stock slf4j binder only. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.spf4j.avro</groupId>
      <artifactId>spf4j-avro</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.threeten</groupId>
      <artifactId>threeten-extra</artifactId>
      <version>1.7.2</version>
    </dependency>
   <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
      <version>3.0.2</version>
    </dependency>
  </dependencies>
</project>
